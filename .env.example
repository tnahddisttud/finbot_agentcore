# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env

# --- Required: Groq API key (main + guard models) ---
GROQ_API_KEY=          # https://console.groq.com/keys

# --- Required for the news search tool ---
SERPAPI_API_KEY=          # https://serpapi.com/dashboard

# --- AgentCore Memory (only needed for the AWS Bedrock cloud deploy) ---
MEMORY_ID=your_agentcore_memory_id_here

# --- Identifies outbound HTTP requests (silences LangChain's USER_AGENT warning) ---
USER_AGENT=finbot-agent/1.0
